[gd_resource type="Resource" script_class="DefinicionPalanca" format=3 uid="uid://blo5r1ln54gjo"]

[ext_resource type="Script" uid="uid://b8auu3p5sl506" path="res://scripts/interacciones/interactuables/mecanismos/definicion_palanca.gd" id="1_definicion"]
[ext_resource type="Texture2D" uid="uid://inyxj1hg0kmw" path="res://assets/interactuables/mecanismos/palanca/palanca_dos_posiciones.png" id="2_textura"]
[ext_resource type="Script" uid="uid://3dmpp1fn7gc7" path="res://scripts/interacciones/examen/fragmento_informacion.gd" id="3_fragmento"]
[ext_resource type="Script" uid="uid://bccqt6gfe8843" path="res://scripts/interacciones/examen/perfil_observacion.gd" id="4_perfil"]

[sub_resource type="Resource" id="Resource_identidad"]
script = ExtResource("3_fragmento")
id_fragmento = &"identidad"
nivel = 1
id_mensaje = &"examen.palanca.basico"

[sub_resource type="Resource" id="Resource_perfil"]
script = ExtResource("4_perfil")

[resource]
script = ExtResource("1_definicion")
textura = ExtResource("2_textura")
id_definicion = &"palanca"
nombre = "Palanca"
descripcion_base = "Una palanca de mecanismo con dos posiciones estables."
etiquetas = Array[StringName]([&"mecanismo"])
fragmentos_informacion = Array[ExtResource("3_fragmento")]([SubResource("Resource_identidad")])
perfil_observacion = SubResource("Resource_perfil")
