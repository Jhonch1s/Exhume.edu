&"estado.npc_envenenado": "Queda envenenado.",
&"estado.npc_inmovilizado": "La telaraña le impide moverse temporalmente.",
&"estado.npc_inmovilizado_expirado": "La telaraña cede y vuelve a poder moverse.",
&"estado.npc_inmovilizado_renovado": "La telaraña renueva su inmovilización.",
&"estado.npc_levantado": "Se levanta al cerrar el turno.",
