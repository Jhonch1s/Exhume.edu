[gd_resource type="Resource" script_class="DefinicionPuerta" format=3 uid="uid://2lts1rw4c3bs"]

[ext_resource type="Script" uid="uid://b0cf7dox0rmm6" path="res://scripts/interacciones/interactuables/puertas/definicion_puerta.gd" id="1_definicion"]
[ext_resource type="Texture2D" uid="uid://duyw3ngdb5g2e" path="res://assets/interactuables/puertas/puerta/puerta_dos_estados_placeholder.png" id="2_textura"]
[ext_resource type="Script" uid="uid://3dmpp1fn7gc7" path="res://scripts/interacciones/examen/fragmento_informacion.gd" id="3_fragmento"]
[ext_resource type="Script" uid="uid://bccqt6gfe8843" path="res://scripts/interacciones/examen/perfil_observacion.gd" id="4_perfil"]
[ext_resource type="AudioStream" path="res://assets/sonidos/puerta/puerta abierta.wav" id="5_sonido_abrir"]
[ext_resource type="AudioStream" path="res://assets/sonidos/puerta/editado/puerta cerrada.wav" id="6_sonido_cerrar"]

[sub_resource type="Resource" id="Resource_identidad"]
script = ExtResource("3_fragmento")
id_fragmento = &"identidad"
nivel = 1
id_mensaje = &"examen.puerta.basico"

[sub_resource type="Resource" id="Resource_perfil"]
script = ExtResource("4_perfil")

[resource]
script = ExtResource("1_definicion")
patron_cerradura = &"cripta_simple"
textura = ExtResource("2_textura")
sonido_abrir = ExtResource("5_sonido_abrir")
sonido_cerrar = ExtResource("6_sonido_cerrar")
id_definicion = &"puerta_cripta_prueba"
nombre = "Puerta de la cripta"
descripcion_base = "Una puerta robusta con una cerradura sencilla."
etiquetas = Array[StringName]([&"puerta", &"mecanismo"])
