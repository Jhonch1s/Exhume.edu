[gd_resource type="Resource" script_class="DefinicionPuerta" load_steps=5 format=3]

[ext_resource type="Script" path="res://scripts/interacciones/interactuables/puertas/definicion_puerta.gd" id="1_definicion"]
[ext_resource type="Texture2D" path="res://assets/interactuables/puertas/puerta/puerta_dos_estados_placeholder.png" id="2_textura"]
[ext_resource type="Script" path="res://scripts/interacciones/examen/fragmento_informacion.gd" id="3_fragmento"]
[ext_resource type="Script" path="res://scripts/interacciones/examen/perfil_observacion.gd" id="4_perfil"]

[sub_resource type="Resource" id="Resource_identidad"]
script = ExtResource("3_fragmento")
id_fragmento = &"identidad"
nivel = 1
id_mensaje = &"examen.puerta.basico"

[sub_resource type="Resource" id="Resource_perfil"]
script = ExtResource("4_perfil")

[resource]
script = ExtResource("1_definicion")
patron_cerradura = &"cripta_simple"
textura = ExtResource("2_textura")
region_cerrada = Rect2(0, 0, 64, 96)
region_abierta = Rect2(64, 0, 64, 96)
desplazamiento_sprite = Vector2(0, -32)
id_definicion = &"puerta_cripta_prueba"
nombre = "Puerta de la cripta"
descripcion_base = "Una puerta robusta con una cerradura sencilla."
etiquetas = Array[StringName]([&"puerta", &"mecanismo"])
fragmentos_informacion = Array[ExtResource("3_fragmento")]([SubResource("Resource_identidad")])
perfil_observacion = SubResource("Resource_perfil")
