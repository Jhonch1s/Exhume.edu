nivel = 3
id_mensaje = &"examen.antorcha_pie.marca_oculta"
pistas_requeridas = Array[StringName]([&"marca_oculta_revelable"])

[sub_resource type="Resource" id="Resource_perfil_antorcha"]
script = ExtResource("4_perfil")

[resource]
script = ExtResource("1_script")
radio_luz = 1
radio_penumbra = 2
altura = 1
permite_caminar = false
familia_fog = &"luz"
coordenada_fog = Vector2i(1, 6)
textura = ExtResource("2_textura")
region_encendida = Rect2(0, 192, 64, 96)
region_apagada = Rect2(64, 192, 64, 96)
mensaje_basico_encendida = &"examen.antorcha_pie.basico_encendida"
mensaje_basico_apagada = &"examen.antorcha_pie.basico_apagada"
sonido_ambiente = ExtResource("5_sonido_ambiente")
sonido_encender = ExtResource("6_sonido_encender")
sonido_apagar = ExtResource("7_sonido_apagar")
id_definicion = &"antorcha_pie"
nombre = "Antorcha de pie"
descripcion_base = "Una antorcha sostenida por un pedestal de piedra."
etiquetas = Array[StringName]([&"fuego", &"calor", &"fuente_luz"])
fragmentos_informacion = Array[ExtResource("3_fragmento")]([SubResource("Resource_identidad"), SubResource("Resource_construccion"), SubResource("Resource_marca_oculta")])
perfil_observacion = SubResource("Resource_perfil_antorcha")
