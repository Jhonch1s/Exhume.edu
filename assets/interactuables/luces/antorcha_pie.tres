[sub_resource type="Resource" id="Resource_identidad"]
script = ExtResource("3_fragmento")
id_fragmento = &"identidad"
nivel = 1
id_mensaje = &"examen.antorcha_pie.basico_encendida"

[sub_resource type="Resource" id="Resource_construccion"]
script = ExtResource("3_fragmento")
id_fragmento = &"construccion"
nivel = 2
id_mensaje = &"examen.antorcha_pie.construccion"

[sub_resource type="Resource" id="Resource_marca_oculta"]
script = ExtResource("3_fragmento")
