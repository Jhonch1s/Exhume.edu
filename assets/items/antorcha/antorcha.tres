[gd_resource type="Resource" script_class="DefinicionItem" format=3]

[ext_resource type="Script" path="res://scripts/interacciones/items/definicion_item.gd" id="1_definicion"]
[ext_resource type="Texture2D" path="res://assets/items/antorcha/icons/antorcha_icono.png" id="2_icono"]
[ext_resource type="PackedScene" path="res://scenes/items/antorcha_suelo.tscn" id="3_mundo"]

[resource]
script = ExtResource("1_definicion")
id_definicion = &"antorcha"
nombre = "Antorcha"
icono = ExtResource("2_icono")
escena_mundo = ExtResource("3_mundo")
descripcion_base = "Una antorcha rudimentaria para conservar la luz durante la exploración."
etiquetas = Array[StringName]([&"luz", &"consumible"])
magnitudes = Dictionary[StringName, float]({
&"duracion": 80.0
})
apilable = true
cantidad_maxima = 10
