[gd_resource type="Resource" script_class="DefinicionItem" format=3]

[ext_resource type="Script" path="res://scripts/interacciones/items/definicion_item.gd" id="definicion"]
[ext_resource type="Texture2D" path="res://assets/items/forja/botas_mago_iniciales/icono.png" id="icono"]
[ext_resource type="PackedScene" path="res://assets/items/forja/botas_mago_iniciales/suelo.tscn" id="mundo"]
[ext_resource type="Texture2D" path="res://assets/items/forja/botas_mago_iniciales/ilustracion.png" id="ilustracion"]


[resource]
script = ExtResource("definicion")
id_definicion = &"botas_mago_iniciales"
nombre = "Botas de tela"
descripcion_base = "Tela reforzada y vendas antiguas protegen los pies durante largas vigilias."
icono = ExtResource("icono")
escena_mundo = ExtResource("mundo")
ilustracion_examen = ExtResource("ilustracion")
etiquetas = Array[StringName]([&"botas"])
clases_permitidas = Array[StringName]([&"Mago"])
efectos_equipo = Array[Dictionary]([{"tipo": "atributo", "atributo": "destreza", "valor": 1}])
magnitudes = Dictionary[StringName, float]({
&"peso": 0.5
})
apilable = false
cantidad_maxima = 1
