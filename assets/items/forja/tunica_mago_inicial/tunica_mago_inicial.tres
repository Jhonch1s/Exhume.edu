[gd_resource type="Resource" script_class="DefinicionItem" format=3]

[ext_resource type="Script" path="res://scripts/interacciones/items/definicion_item.gd" id="definicion"]
[ext_resource type="Texture2D" path="res://assets/items/forja/tunica_mago_inicial/icono.png" id="icono"]
[ext_resource type="PackedScene" path="res://assets/items/forja/tunica_mago_inicial/suelo.tscn" id="mundo"]
[ext_resource type="Texture2D" path="res://assets/items/forja/tunica_mago_inicial/ilustracion.png" id="ilustracion"]


[resource]
script = ExtResource("definicion")
id_definicion = &"tunica_mago_inicial"
nombre = "Túnica de tela"
descripcion_base = "Capas de tela ceniza cosidas con símbolos tenues que sobreviven al desgaste."
icono = ExtResource("icono")
escena_mundo = ExtResource("mundo")
ilustracion_examen = ExtResource("ilustracion")
etiquetas = Array[StringName]([&"armadura"])
clases_permitidas = Array[StringName]([&"Mago"])
magnitudes = Dictionary[StringName, float]({
&"peso": 0.5
})
apilable = false
cantidad_maxima = 1
