[gd_resource type="Resource" script_class="DefinicionItem" format=3]

[ext_resource type="Script" path="res://scripts/interacciones/items/definicion_item.gd" id="definicion"]
[ext_resource type="Texture2D" path="res://assets/items/forja/botas_ladron_inicial/icono.png" id="icono"]
[ext_resource type="PackedScene" path="res://assets/items/forja/botas_ladron_inicial/suelo.tscn" id="mundo"]
[ext_resource type="Texture2D" path="res://assets/items/forja/botas_ladron_inicial/ilustracion.png" id="ilustracion"]


[resource]
script = ExtResource("definicion")
id_definicion = &"botas_ladron_inicial"
nombre = "Botas de cuero"
descripcion_base = "Cuero flexible de suela gastada, cómodo para avanzar sin anunciar cada paso."
icono = ExtResource("icono")
escena_mundo = ExtResource("mundo")
ilustracion_examen = ExtResource("ilustracion")
etiquetas = Array[StringName]([&"botas"])
clases_permitidas = Array[StringName]([&"Ladrón"])
magnitudes = Dictionary[StringName, float]({
&"peso": 0.5
})
apilable = false
cantidad_maxima = 1
