[gd_resource type="Resource" script_class="DefinicionItem" format=3]

[ext_resource type="Script" path="res://scripts/interacciones/items/definicion_item.gd" id="definicion"]
[ext_resource type="Texture2D" path="res://assets/items/forja/casco_inicial/icono.png" id="icono"]
[ext_resource type="PackedScene" path="res://assets/items/forja/casco_inicial/suelo.tscn" id="mundo"]
[ext_resource type="Texture2D" path="res://assets/items/forja/casco_inicial/ilustracion.png" id="ilustracion"]


[resource]
script = ExtResource("definicion")
id_definicion = &"casco_inicial"
nombre = "Casco de hierro"
descripcion_base = "Su estrecha visera deja ver el camino, pero oculta el rostro de quien lo recorre."
icono = ExtResource("icono")
escena_mundo = ExtResource("mundo")
ilustracion_examen = ExtResource("ilustracion")
etiquetas = Array[StringName]([&"casco"])
clases_permitidas = Array[StringName]([&"Guerrero"])
efectos_equipo = Array[Dictionary]([{"tipo": "atributo", "atributo": "voluntad", "valor": 1}])
magnitudes = Dictionary[StringName, float]({
&"peso": 1.5
})
apilable = false
cantidad_maxima = 1
