[gd_resource type="Resource" script_class="DefinicionItem" format=3]

[ext_resource type="Script" path="res://scripts/interacciones/items/definicion_item.gd" id="definicion"]
[ext_resource type="Texture2D" path="res://assets/items/forja/pechera_inicial/icono.png" id="icono"]
[ext_resource type="PackedScene" path="res://assets/items/forja/pechera_inicial/suelo.tscn" id="mundo"]
[ext_resource type="Texture2D" path="res://assets/items/forja/pechera_inicial/ilustracion.png" id="ilustracion"]


[resource]
script = ExtResource("definicion")
id_definicion = &"pechera_inicial"
nombre = "Pechera de hierro"
descripcion_base = ""
icono = ExtResource("icono")
escena_mundo = ExtResource("mundo")
ilustracion_examen = ExtResource("ilustracion")
etiquetas = Array[StringName]([&"armadura"])
clases_permitidas = Array[StringName]([&"Guerrero"])
efectos_equipo = Array[Dictionary]([{"tipo": "armadura", "valor": 1}])
magnitudes = Dictionary[StringName, float]({
&"peso": 4.0
})
apilable = false
cantidad_maxima = 1
