[gd_resource type="Resource" script_class="DefinicionItem" format=3]

[ext_resource type="Script" path="res://scripts/interacciones/items/definicion_item.gd" id="definicion"]
[ext_resource type="Texture2D" path="res://assets/items/forja/escudo_inicial/icono.png" id="icono"]
[ext_resource type="PackedScene" path="res://assets/items/forja/escudo_inicial/suelo.tscn" id="mundo"]
[ext_resource type="Texture2D" path="res://assets/items/forja/escudo_inicial/ilustracion.png" id="ilustracion"]


[resource]
script = ExtResource("definicion")
id_definicion = &"escudo_inicial"
nombre = "Escudo de madera reforzado"
descripcion_base = "Hierro ennegrecido y madera agrietada; bajo los golpes aún se distingue un blasón granate."
icono = ExtResource("icono")
escena_mundo = ExtResource("mundo")
ilustracion_examen = ExtResource("ilustracion")
etiquetas = Array[StringName]([&"escudo"])
clases_permitidas = Array[StringName]([&"Guerrero"])
magnitudes = Dictionary[StringName, float]({
&"peso": 2.5
})
apilable = false
cantidad_maxima = 1
