[gd_resource type="Resource" script_class="DefinicionItem" format=3]

[ext_resource type="Script" path="res://scripts/interacciones/items/definicion_item.gd" id="definicion"]
[ext_resource type="Texture2D" path="res://assets/items/forja/frasco_de_bruma/icono.png" id="icono"]
[ext_resource type="PackedScene" path="res://assets/items/forja/frasco_de_bruma/suelo.tscn" id="mundo"]
[ext_resource type="Texture2D" path="res://assets/items/forja/frasco_de_bruma/ilustracion.png" id="ilustracion"]
[ext_resource type="Script" path="res://scripts/interacciones/items/reaccion_impacto_superficie.gd" id="reaccion"]
[ext_resource type="PackedScene" path="res://assets/items/forja/frasco_de_bruma/efecto.tscn" id="efecto"]

[sub_resource type="Resource" id="ReaccionImpacto"]
script = ExtResource("reaccion")
escena_superficie = ExtResource("efecto")
radio = 2

[resource]
script = ExtResource("definicion")
id_definicion = &"frasco_de_bruma"
nombre = "Frasco de bruma"
descripcion_base = "Un pequeño recipiente de cerámica sellado con cera. Al romperse, libera una niebla densa que oculta el camino a quienes lo vigilan."
icono = ExtResource("icono")
escena_mundo = ExtResource("mundo")
ilustracion_examen = ExtResource("ilustracion")
etiquetas = Array[StringName]([&"arrojable", &"fragil", &"humo"])
magnitudes = Dictionary[StringName, float]({
&"peso": 0.8
})
apilable = true
cantidad_maxima = 6
reaccion_impacto = SubResource("ReaccionImpacto")
