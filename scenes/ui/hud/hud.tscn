[sub_resource type="Shader" id="ShaderBarAnimated"]
code = "shader_type canvas_item;\n\nuniform float speed = 0.55;\nuniform float intensity = 0.10;\n\nvoid fragment() {\n\tvec4 base = COLOR;\n\tfloat onda = sin(UV.x * 18.0 + UV.y * 3.0 + TIME * speed);\n\tfloat sombra = smoothstep(-0.65, 0.65, onda) * intensity;\n\tCOLOR = vec4(base.rgb * (1.0 - sombra), base.a);\n}\n"

[sub_resource type="ShaderMaterial" id="MaterialBarAnimated"]
shader = SubResource("ShaderBarAnimated")

