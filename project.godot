; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="exhume"
run/main_scene="uid://cq6eyihgiwmey"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://icon.svg"
run/main_scene.web="res://scenes/menu/menu_principal.tscn"

[autoload]

DialogueManager="*uid://c3rodes2l3gxb"
EstadoPartida="*res://scripts/estado_partida.gd"
CursorJuego="*res://scripts/ui/cursor_juego.gd"

[dialogue_manager]

runtime/balloon_path="res://scenes/dialogue/balloon.tscn"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/size/mode=3
window/stretch/mode="canvas_items"

[editor_plugins]

enabled=PackedStringArray("res://addons/dialogue_manager/plugin.cfg")

[gui]

theme/custom_font="res://assets/ui/fonts/Amarante-Regular.ttf"

[internationalization]

locale/translations_pot_files=PackedStringArray("res://dialogues/my_dialogue.dialogue", "res://dialogues/antorchaDialogoPrueba.dialogue", "res://dialogues/personajes/trompo.dialogue", "res://dialogues/personajes/prueba_actitud.dialogue", "res://dialogues/personajes/prueba_tirada.dialogue", "res://dialogues/personajes/prueba_consecuencias.dialogue", "res://dialogues/triggers/prueba_trigger.dialogue", "res://dialogues/prision/guardias.dialogue", "res://dialogues/prision/derrumbe.dialogue", "res://dialogues/prision/roffa.dialogue", "res://dialogues/prision/peligro1.dialogue", "res://dialogues/prision/entrada.dialogue", "res://dialogues/prision/salaprincipal.dialogue", "res://dialogues/templo/lamentos.dialogue")

[physics]

3d/physics_engine="Jolt Physics"

[rendering]

rendering_device/driver.windows="d3d12"
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
environment/defaults/default_clear_color=Color(0, 0, 0, 1)
