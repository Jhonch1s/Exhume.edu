[sub_resource type="Resource" id="basico"]
script = ExtResource("1_fragmento")
id_fragmento = &"identidad"
nivel = 1
id_mensaje = &"examen.templo.nota_estatua.basico"

[sub_resource type="Resource" id="detalle"]
script = ExtResource("1_fragmento")
id_fragmento = &"detalle"
nivel = 2
id_mensaje = &"examen.templo.nota_estatua.detalle"

[sub_resource type="Resource" id="perfil"]
script = ExtResource("3_perfil")
alcance_secreto = 0.0

[resource]
script = ExtResource("4_definicion")
id_definicion = &"templo_nota_tras_estatua"
nombre = "Nota polvorienta"
descripcion_base = "Una hoja polvorienta yace cerca de la gran estatua. La escritura todavía es legible."
ilustracion_examen = ExtResource("2_ilustracion")
